{
  "manifest_version": 3,
  "name": "VoiceiQ Meetings",
  "version": "1.1.0",
  "description": "Tells VoiceiQ who is talking in browser meetings, so each line of your meeting notes goes to the right person.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://*.zoom.com/*",
        "https://meet.jit.si/*",
        "https://*.whereby.com/*",
        "https://app.slack.com/*",
        "https://discord.com/*",
        "https://*.webex.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://*.zoom.com/*",
        "https://meet.jit.si/*",
        "https://*.whereby.com/*",
        "https://app.slack.com/*",
        "https://discord.com/*",
        "https://*.webex.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
