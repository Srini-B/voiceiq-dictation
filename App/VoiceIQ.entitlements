<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone access under Hardened Runtime (release builds). Not sandboxed:
	     consuming CGEventTaps and synthetic paste are incompatible with App Sandbox. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Apple Events to Music and Spotify: "Pause Music and Spotify while
	     dictating" (MediaPause). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Calendar under Hardened Runtime: meeting titles and invitees, when
	     the user connects the calendar (CalendarMeetings). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
